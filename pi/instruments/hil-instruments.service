[Unit]
Description=HIL instruments service (bench voltmeter / logic analyzer)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/hil-instruments/instruments_server.py
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
